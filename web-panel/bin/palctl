#!/usr/bin/env bash
set -Eeuo pipefail

MANAGER="${PALWORLD_MANAGER:-/opt/palworld/palworld-manager.sh}"
[[ -f "$MANAGER" ]] || { echo "Manager script not found: $MANAGER" >&2; exit 1; }

cmd="${1:-}"
shift || true

case "$cmd" in
  start|stop|restart|update|backup|status|settings|players|metrics|info|save|doctor)
    exec bash "$MANAGER" "$cmd" "$@"
    ;;
  preset)
    [[ $# -eq 1 ]] || { echo "Usage: palctl preset NAME" >&2; exit 2; }
    exec bash "$MANAGER" preset "$1"
    ;;
  set)
    [[ $# -gt 0 ]] || { echo "Usage: palctl set Key=Value ..." >&2; exit 2; }
    exec bash "$MANAGER" set "$@"
    ;;
  announce)
    message="${1:-}"
    [[ -n "$message" ]] || { echo "Usage: palctl announce MESSAGE" >&2; exit 2; }
    exec bash "$MANAGER" announce --message "$message"
    ;;
  logs)
    exec bash "$MANAGER" logs
    ;;
  *)
    echo "Allowed commands: start stop restart update backup status settings players metrics info save doctor preset set announce logs" >&2
    exit 2
    ;;
esac
