NODE_ENV=production
WEB_PANEL_HOST=0.0.0.0
WEB_PANEL_PORT=8080
WEB_PANEL_PUBLIC_URL=http://YOUR_SERVER_IP:8080
WEB_PANEL_DOMAIN=
WEB_PANEL_TLS_EMAIL=

# Browser users log in to this panel, not directly to Palworld REST.
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=change-this-long-password
SESSION_SECRET=change-this-to-a-long-random-secret
ALLOW_REGISTRATION=true

# Palworld REST should stay bound to 127.0.0.1 or private LAN.
PALWORLD_REST_URL=http://127.0.0.1:8212
PALWORLD_REST_USER=admin
PALWORLD_ADMIN_PASSWORD=put-your-palworld-admin-password-here
PUBLIC_GAME_HOST=YOUR_SERVER_IP_OR_DOMAIN
PUBLIC_GAME_IP=YOUR_SERVER_IP_OR_DOMAIN
PUBLIC_GAME_PORT=8211

# Optional Discord widget. Enable Server Settings -> Widget in Discord first.
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=

# Steam login works through Steam OpenID and needs no app secret.
STEAM_AUTH_ENABLED=true

# Optional Xbox/Microsoft login. Create a Microsoft Entra app registration.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=consumers

# Installed by palworld-manager.sh on Ubuntu.
PALWORLD_CONTROL=/opt/palworld/web-panel/bin/palctl
PANEL_DATA_DIR=/opt/palworld/web-panel/data
